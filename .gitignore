# backups and generated
*.bak
*.new

# OS cruft
.DS_Store
Thumbs.db

# machine-local project state (if this repo is ever used as a workspace)
.claude/.active-story

# herdr runtime (never part of the repo, listed for safety)
*.sock
herdr-*.log
session.json

# never commit account state or credentials, even by accident
.credentials.json
.names.json
.claude.json
.sync-source.json
.claude-accounts/
__pycache__/
*.pyc

# written by the PreCompact autosave hook in whatever folder a session runs in
NOTES.autosave.md

# the sanitization guard's private denylist: the real names, never committed (ADR-007)
.sanitize/
