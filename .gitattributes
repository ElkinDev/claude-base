# Hooks and their fixtures: read by python and by Git Bash, and compared as text by the
# fixture tests, so they stay LF on every checkout, on Windows as well.
claude/hooks/** text eol=lf
project-template/scripts/hooks/** text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
# The sanitize guard: git runs the wrappers under sh, and the rule files are tab separated.
scripts/git-hooks/** text eol=lf
scripts/sanitize-rules.txt text eol=lf
scripts/sanitize-allow.txt text eol=lf
scripts/tests/fixtures/sanitize/** text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.ps1 text eol=crlf
