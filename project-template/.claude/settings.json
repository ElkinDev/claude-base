{
  "env": {},
  "extraKnownMarketplaces": {
    "claude-base": {
      "source": {
        "source": "github",
        "repo": "<owner>/<repo>",
        "sha": "<pinned-commit>"
      }
    }
  },
  "enabledPlugins": {
    "groundwork@claude-base": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/hooks/filter-gradle-output.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
